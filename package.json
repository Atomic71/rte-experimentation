{
  "name": "editor-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/make-html-export.mjs",
    "build:lib": "tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "yalc:publish": "npm run build:lib && yalc publish",
    "link:local": "npm run build:lib && yalc publish --private --push"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@tippyjs/react": "^4.2.6",
    "@tiptap/extension-bubble-menu": "^3.3.0",
    "@tiptap/extension-floating-menu": "^3.3.0",
    "@tiptap/extension-link": "^3.3.0",
    "@tiptap/extension-mention": "^3.3.0",
    "@tiptap/extension-placeholder": "^3.3.0",
    "@tiptap/extension-underline": "^3.3.0",
    "@tiptap/react": "^3.3.0",
    "@tiptap/starter-kit": "^3.3.0",
    "@tiptap/suggestion": "^3.3.0",
    "@types/lodash": "^4.17.20",
    "@types/validator": "^13.15.2",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tippy.js": "^6.3.7",
    "tiptap-text-direction": "^0.3.2",
    "validator": "^13.15.15",
    "yalc": "^1.0.0-pre.53"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/index.html": "./dist/index.html",
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.js"
    }
  }
}
